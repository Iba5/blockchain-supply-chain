# Demo Mode Configuration
# Set to true to run without MetaMask using embedded demo wallet
VITE_DEMO_MODE=false

# Sepolia RPC URL (required in demo mode)
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Demo wallet private key (required in demo mode)
# IMPORTANT: Only use a throwaway wallet with no real funds!
# This key will be bundled into the frontend build and become publicly visible.
VITE_DEMO_PRIVATE_KEY=your_demo_wallet_private_key_without_0x_prefix

# Access gate code (soft demo protection, not real security)
# This prevents random visitors from modifying demo data during presentations.
# Note: This is a UX/demo-integrity feature, not a security boundary.
# The demo wallet's private key is already bundled client-side by design.
VITE_ACCESS_CODE=changeme
